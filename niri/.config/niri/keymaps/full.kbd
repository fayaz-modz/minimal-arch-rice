(defcfg
    process-unmapped-keys yes
    ;; The 2.4G receiver's "Consumer Control" interface reports KEY_MUTE as
    ;; permanently held, which makes kanata busy-wait (100% CPU) at startup and
    ;; never finish registering devices. Don't grab that interface.
    linux-dev-names-exclude "2.4G Consumer Control"
    ;; Needed by waybar's custom/kanata-layer module: without this kanata never
    ;; prints "(deflayer <name> ...)" so /tmp/kanata_layer is never written.
    log-layer-changes yes
)

(defsrc
    esc
    tab       q    w    e    r    t    y    u    i    o    p    [    ]
    caps      a    s    d    f    g    h    j    k    l    ;    '    enter
    lsft      z    x    c    v    b    n    m    ,    .    /    rsft
    lctl      lmet lalt          spc             ralt rctl
)

(defvirtualkeys
    v_slck slck
)

(defvar
    ;; Note: consider using different time values for your different fingers.
    ;; For example, your pinkies might be slower to release keys and index
    ;; fingers faster.
    tap-time 200
    hold-time 200 
    hold-time-slow 300 
)

(defalias
    dict (multi (on-press tap-vkey v_slck) (on-release tap-vkey v_slck))
    !  S-1
    @  S-2
    #  S-3
    $  S-4
    %  S-5
    ^  S-6
    &  S-7
    *  S-8
)

(defalias
    meh   (multi ctl alt sft)
    tmeh  (tap-hold $tap-time $hold-time spc @meh)

    l_num (layer-toggle symb)
    num   (layer-switch numb)
    bse   (layer-switch base)

    f     (tap-hold $tap-time $hold-time f   (layer-while-held numb))
    d     (tap-hold $tap-time $hold-time d   (layer-while-held mouse))
    c     (tap-hold $tap-time $hold-time c   (layer-while-held ctrls))
    spc   (tap-hold $tap-time $hold-time spc (layer-while-held symb))

    caps  (tap-hold-press $tap-time $hold-time caps lctl)
    ralt  (tap-hold-press $tap-time $hold-time @num @l_num)
    lctl  (tap-hold-press $tap-time $hold-time esc  lctl)
)

(deflayer base
    esc
    tab       q     w     e     r     t     y     u     i     o     p     [    ]
    @caps     a     s     @d    @f    g     h     j     k     l     ;     '    enter
    lsft      z     x     @c    v     b     n     m     ,     .     /     rsft
    @lctl     lmet  lalt           @spc           @ralt rctl
)

(deflayer numb
    esc
    tab       q     w     e     r     t     y     kp7   kp8   kp9   kp=   [    ]
    @caps     a     s     d     f     g     h     kp4   kp5   kp6   kp+   '    enter
    lsft      z     x     c     v     b     kp0   kp1   kp2   kp3   kp.   rsft
    @lctl     lmet  lalt           @spc           @bse rctl
)

(deflayer symb
    esc
    tab       @!    @@    @#    @$    @%    y     u     i     del   bspc  [    ]
    @caps     @&    @*    @$    @#    g     left  down  up    right ;     '    enter
    lsft      z     x     @^    @^    b     n     m     ,     .     @%      rsft
    @lctl     lmet  lalt           @spc           @ralt rctl
)

(deflayer mouse
    esc
    tab       q     w     e     r     t     y     u     i     o     p     [    ]
    @caps     mlft  mrgt  @d    @f    g     @ml   @md   @mu   @mr   ;     '    mltp
    lsft      z     x     c     v     @mwl  @mwd  @mwu  @mwr  .     /     rsft
    @lctl     lmet  lalt           @spc           @ralt rctl
)

(deflayer ctrls
    esc
    tab       q     w     e     r     t     y     u     i     o     p     [    ]
    @caps     a     s     @d    @f    g     🔅    🔉    🔊    🔆    ;     '    enter
    lsft      z     x     c     v     @dict @dict 🔇     ,     .     /     rsft
    @lctl     lmet  lalt           @spc           @ralt rctl
)

(defalias
  ml  (🖱accel← 4 450 1 5)    
  mr  (🖱accel→ 4 450 1 5)
  mu  (🖱accel↑ 4 450 1 5)
  md  (🖱accel↓ 4 450 1 5)

  mwu (🖱☸↑ 100 80)
  mwd (🖱☸↓ 100 80)
  mwl (🖱☸← 100 80)
  mwr (🖱☸→ 100 80)
)

